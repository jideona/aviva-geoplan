# Copy to infra/.env and set real values. Never commit infra/.env
POSTGRES_DB=geoplan
POSTGRES_USER=geoplan
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=geoplan
MINIO_ROOT_PASSWORD=change-me-in-local-env
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=geoplan

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Seed account created by `make seed`. Change the password immediately.
SEED_ADMIN_EMAIL=admin@avivanetworx.com.ng
SEED_ADMIN_PASSWORD=change-me-on-first-login

# Optional MapLibre style URL. Left blank, the map uses a plain engineering
# basemap. Do not point this at a tile service you are not licensed to use.
VITE_BASEMAP_STYLE_URL=
VITE_API_URL=http://localhost:8000
